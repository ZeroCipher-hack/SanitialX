# SanitialX Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# ── Application Configuration ──────────────────────────────────────────────
SANITIALX_APP_NAME=SanitialX
SANITIALX_ENVIRONMENT=production
SANITIALX_DEBUG=false
SANITIALX_LOG_LEVEL=INFO

# ── Network Capture / Sensor Configuration ────────────────────────────────
SANITIALX_SNIFFER_INTERFACE=eth0
SANITIALX_SNIFFER_FILTER=

# ── Redis Event Bus ────────────────────────────────────────────────────────
SANITIALX_REDIS_URL=redis://redis:6379/0

# ── PostgreSQL Database ───────────────────────────────────────────────────
SANITIALX_DATABASE_URL=postgresql+asyncpg://sanitialx:sanitialx_password_change_me@postgres:5432/sanitialx

# ── API Server & Authentication ───────────────────────────────────────────
SANITIALX_API_HOST=0.0.0.0
SANITIALX_API_PORT=8000
SANITIALX_FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SANITIALX_API_KEY=change_this_placeholder_api_key_in_production
SANITIALX_JWT_SECRET_KEY=change_this_jwt_secret_key_to_a_secure_random_string_in_production
SANITIALX_JWT_ALGORITHM=HS256

# ── Endpoint Agent Health ──────────────────────────────────────────────────
# Agents normally heartbeat every 30 seconds; after 120 seconds without one,
# the backend automatically marks the enrolled endpoint OFFLINE.
SANITIALX_AGENT_HEARTBEAT_INTERVAL_SECONDS=30
SANITIALX_AGENT_OFFLINE_TIMEOUT_SECONDS=120
SANITIALX_AGENT_OFFLINE_CHECK_INTERVAL_SECONDS=30

# Endpoint version policy. Heartbeats report CURRENT, OUTDATED, UNSUPPORTED,
# or UNKNOWN. This is advisory only; agents do not auto-update themselves.
SANITIALX_AGENT_LINUX_MINIMUM_VERSION=0.2.0
SANITIALX_AGENT_LINUX_LATEST_VERSION=0.2.0
SANITIALX_AGENT_WINDOWS_MINIMUM_VERSION=0.1.0
SANITIALX_AGENT_WINDOWS_LATEST_VERSION=0.1.0

# ── Google Gemini AI ───────────────────────────────────────────────────────
# Keep this value server-side. Never use NEXT_PUBLIC_ for this key.
SANITIALX_GEMINI_API_KEY=
SANITIALX_GEMINI_MODEL=gemini-3.6-flash

# ── Vulnerability Intelligence Scheduler ──────────────────────────────────
# Minimum enforced interval is 900 seconds (15 minutes).
SANITIALX_VULNERABILITY_SYNC_INTERVAL_SECONDS=3600

# SentinelX Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# ── Application Configuration ──────────────────────────────────────────────
SENTINELX_APP_NAME=SentinelX
SENTINELX_ENVIRONMENT=production
SENTINELX_DEBUG=false
SENTINELX_LOG_LEVEL=INFO

# ── Network Capture / Sensor Configuration ────────────────────────────────
SENTINELX_SNIFFER_INTERFACE=eth0
SENTINELX_SNIFFER_FILTER=

# ── Redis Event Bus ────────────────────────────────────────────────────────
SENTINELX_REDIS_URL=redis://redis:6379/0

# ── PostgreSQL Database ───────────────────────────────────────────────────
SENTINELX_DATABASE_URL=postgresql+asyncpg://sentinelx:sentinelx_password_change_me@postgres:5432/sentinelx

# ── API Server & Authentication ───────────────────────────────────────────
SENTINELX_API_HOST=0.0.0.0
SENTINELX_API_PORT=8000
SENTINELX_FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SENTINELX_API_KEY=change_this_placeholder_api_key_in_production
SENTINELX_JWT_SECRET_KEY=change_this_jwt_secret_key_to_a_secure_random_string_in_production
SENTINELX_JWT_ALGORITHM=HS256

# ── Endpoint Agent Health ──────────────────────────────────────────────────
# Agents normally heartbeat every 30 seconds; after 120 seconds without one,
# the backend automatically marks the enrolled endpoint OFFLINE.
SENTINELX_AGENT_HEARTBEAT_INTERVAL_SECONDS=30
SENTINELX_AGENT_OFFLINE_TIMEOUT_SECONDS=120
SENTINELX_AGENT_OFFLINE_CHECK_INTERVAL_SECONDS=30

# Endpoint version policy. Heartbeats report CURRENT, OUTDATED, UNSUPPORTED,
# or UNKNOWN. This is advisory only; agents do not auto-update themselves.
SENTINELX_AGENT_LINUX_MINIMUM_VERSION=0.2.0
SENTINELX_AGENT_LINUX_LATEST_VERSION=0.2.0
SENTINELX_AGENT_WINDOWS_MINIMUM_VERSION=0.1.0
SENTINELX_AGENT_WINDOWS_LATEST_VERSION=0.1.0

# ── Google Gemini AI ───────────────────────────────────────────────────────
# Keep this value server-side. Never use NEXT_PUBLIC_ for this key.
SENTINELX_GEMINI_API_KEY=
SENTINELX_GEMINI_MODEL=gemini-3.6-flash

# ── Vulnerability Intelligence Scheduler ──────────────────────────────────
# Minimum enforced interval is 900 seconds (15 minutes).
SENTINELX_VULNERABILITY_SYNC_INTERVAL_SECONDS=3600
